# =============================================================
# DIO Bootcamp Monitor — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais:
#   cp .env.example .env        (Linux/macOS)
#   Copy-Item .env.example .env (Windows PowerShell)
# NUNCA commite o arquivo .env com valores secretos.
# =============================================================

# --- Telegram ---
# Token do bot criado via @BotFather (formato: 123456789:AA...)
TELEGRAM_BOT_TOKEN=seu_token_aqui

# ID do chat ou canal para receber as notificações
# Use @userinfobot para descobrir seu chat ID
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# --- Comportamento ---

# Notificar bootcamps existentes na primeira execução?
# true = notifica todos | false = apenas registra (recomendado)
# ATENÇÃO: com o histórico vazio e true, o bot envia uma mensagem por bootcamp
# do catálogo (~217 hoje) de uma só vez.
INITIAL_NOTIFY=false

# Enviar resumo diário ao final de cada execução?
SEND_DAILY_SUMMARY=false

# Enviar resumo mesmo quando não houver novidades?
# Só tem efeito se SEND_DAILY_SUMMARY=true
SEND_EMPTY_SUMMARY=false

# --- Limites ---

# Número máximo de páginas de detalhe por execução
MAX_DETAIL_PAGES=10

# Intervalo em segundos entre requisições HTTP
REQUEST_DELAY_SECONDS=2

# --- Logging ---
# Nível de log: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- URL do catálogo ---
# Altere apenas se a DIO mudar o endereço público
DIO_BOOTCAMP_URL=https://www.dio.me/bootcamp
